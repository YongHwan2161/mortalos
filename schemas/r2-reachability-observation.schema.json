{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mortal-os.com/schemas/r2-reachability-observation.schema.json",
  "title": "MortalOS R2 WebRTC reachability observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attempt",
    "capsule_id",
    "claim_scope",
    "completed_at",
    "connections",
    "expected_path_classes",
    "failure_code",
    "format",
    "lineage_head",
    "non_authority",
    "observation_id",
    "organism_id",
    "outcome",
    "plan_id",
    "product_result",
    "profile",
    "resource_bytes",
    "resource_digest",
    "source_commit",
    "source_tree",
    "started_at"
  ],
  "properties": {
    "attempt": { "type": "integer", "minimum": 1, "maximum": 20 },
    "capsule_id": { "$ref": "#/$defs/digest" },
    "claim_scope": { "const": "single-operator-reachability" },
    "completed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "connections": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/connection" }
    },
    "expected_path_classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/pathClass" }
    },
    "failure_code": {
      "oneOf": [
        { "type": "null" },
        {
          "enum": [
            "WEBRTC_CONNECTION_CLOSED",
            "WEBRTC_ICE_TIMEOUT",
            "WEBRTC_OPEN_TIMEOUT",
            "WEBRTC_ROUTE_AMBIGUOUS",
            "WEBRTC_ROUTE_LIMIT",
            "WEBRTC_ROUTE_UNAVAILABLE",
            "R2_BELOW_QUORUM_ACCEPTED",
            "R2_CORRUPT_COPY_ACCEPTED",
            "R2_DUPLICATE_EFFECT",
            "R2_INTERNAL_ERROR",
            "R2_LINEAGE_MISMATCH",
            "R2_RESOURCE_MISMATCH",
            "R2_UNEXPECTED_PATH_CLASS"
          ]
        }
      ]
    },
    "format": { "const": "mortalos-webrtc-reachability-observation/1" },
    "lineage_head": { "$ref": "#/$defs/digest" },
    "non_authority": { "const": true },
    "observation_id": { "$ref": "#/$defs/digest" },
    "organism_id": { "$ref": "#/$defs/digest" },
    "outcome": { "enum": ["pass", "fail"] },
    "plan_id": { "$ref": "#/$defs/digest" },
    "product_result": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/productResult" }
      ]
    },
    "profile": {
      "enum": ["lan-direct", "nat-stun", "forced-turn", "reconnect-fallback"]
    },
    "resource_bytes": { "type": "integer", "minimum": 1, "maximum": 131072 },
    "resource_digest": { "$ref": "#/$defs/digest" },
    "source_commit": { "$ref": "#/$defs/commit" },
    "source_tree": { "$ref": "#/$defs/commit" },
    "started_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "profile": { "const": "reconnect-fallback" } } },
      "then": {
        "properties": {
          "expected_path_classes": { "type": "array", "minItems": 2, "maxItems": 2 }
        }
      },
      "else": {
        "properties": {
          "connections": { "type": "array", "maxItems": 1 },
          "expected_path_classes": { "type": "array", "minItems": 1, "maxItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "pass" } } },
      "then": {
        "properties": {
          "failure_code": { "type": "null" },
          "product_result": { "$ref": "#/$defs/productResult" }
        }
      },
      "else": {
        "properties": {
          "failure_code": { "type": "string" },
          "product_result": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "profile": { "const": "lan-direct" } } },
      "then": { "properties": { "expected_path_classes": { "const": ["host"] } } }
    },
    {
      "if": { "properties": { "profile": { "const": "nat-stun" } } },
      "then": { "properties": { "expected_path_classes": { "const": ["srflx"] } } }
    },
    {
      "if": { "properties": { "profile": { "const": "forced-turn" } } },
      "then": { "properties": { "expected_path_classes": { "const": ["relay"] } } }
    },
    {
      "if": { "properties": { "profile": { "const": "reconnect-fallback" } } },
      "then": {
        "properties": {
          "expected_path_classes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              { "enum": ["host", "srflx"] },
              { "const": "relay" }
            ],
            "items": false
          }
        }
      }
    }
  ],
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[A-Za-z0-9_-]{43}$" },
    "pathClass": { "enum": ["host", "srflx", "relay"] },
    "productResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "below_quorum_failed_closed",
        "continuity_duplicate_effects",
        "corrupt_copy_rejected",
        "provider_duplicate_effects",
        "recovered_capsule_id",
        "recovered_organism_id",
        "recovered_resource_bytes",
        "recovered_resource_digest",
        "source_retired_before_recovery",
        "successor_lineage_head"
      ],
      "properties": {
        "below_quorum_failed_closed": { "const": true },
        "continuity_duplicate_effects": { "const": 0 },
        "corrupt_copy_rejected": { "const": true },
        "provider_duplicate_effects": { "const": 0 },
        "recovered_capsule_id": { "$ref": "#/$defs/digest" },
        "recovered_organism_id": { "$ref": "#/$defs/digest" },
        "recovered_resource_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 131072
        },
        "recovered_resource_digest": { "$ref": "#/$defs/digest" },
        "source_retired_before_recovery": { "const": true },
        "successor_lineage_head": { "$ref": "#/$defs/digest" }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "local_route_class",
        "non_authority",
        "path_class",
        "remote_route_class"
      ],
      "properties": {
        "format": { "const": "mortalos-webrtc-selected-route/1" },
        "local_route_class": { "$ref": "#/$defs/pathClass" },
        "non_authority": { "const": true },
        "path_class": { "$ref": "#/$defs/pathClass" },
        "remote_route_class": { "$ref": "#/$defs/pathClass" }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answerer_route", "offerer_route", "sequence"],
      "properties": {
        "answerer_route": { "$ref": "#/$defs/route" },
        "offerer_route": { "$ref": "#/$defs/route" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 2 }
      }
    }
  }
}
